      "key": "canadian-tech-internships",
      "name": "Canadian Tech Internships (negarprh)",
      "careerUrl": "https://github.com/negarprh/Canadian-Tech-Internships-2027",
      "adapter": "markdown-table",
      "enabled": true,
      "config": { "url": "https://raw.githubusercontent.com/negarprh/Canadian-Tech-Internships-{year}/main/README.md" }
