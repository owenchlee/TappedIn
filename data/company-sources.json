      "enabled": true,
      "config": { "url": "https://raw.githubusercontent.com/vanshb03/Summer{year}-Internships/dev/.github/scripts/listings.json", "keepsClosedJobs": true },
      "match": { "regions": ["canada", "remote", "us"] }
    },
