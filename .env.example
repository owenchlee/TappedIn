# Local dev: relative paths resolve against the project root (see lib/dbUrl.ts), so this creates ./dev.db
# Railway: use an absolute path into the mounted volume, e.g. file:/data/coophub.db
DATABASE_URL="file:./dev.db"

# Long random string. Required as a Bearer token on /api/cron/refresh and /api/sources/[key]/run.
CRON_SECRET="change-me-to-a-long-random-string"

# "1" to run the in-process daily scheduler (and its boot catch-up check). Leave "0" for local dev
# unless you're intentionally testing the fetcher against real career pages.
ENABLE_CRON="0"

# Standard 5-field cron expression, evaluated in the TZ below.
CRON_SCHEDULE="0 8 * * *"
TZ="America/Toronto"

# Sent as the User-Agent header on every career-page fetch, so a site owner can identify the traffic.
FETCH_USER_AGENT="CoopHub/1.0 (personal job tracker)"
