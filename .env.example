# Postgres connection string.
# Local: `npm run db:dev` starts a local Prisma Postgres and prints the URL (postgres://…localhost:51214/…).
# Vercel: set automatically when you connect a Neon / Prisma Postgres database to the project.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Local `prisma dev` serves one connection at a time. Leave unset in production.
DB_POOL_MAX="1"

# Login password, and the secret that signs the session cookie + calendar-feed link.
# With no APP_PASSWORD the app has no login — fine locally, never on a deployment.
APP_PASSWORD="change-me"
AUTH_SECRET="a-long-random-string"

# Bearer token for /api/cron/refresh. Vercel Cron sends it automatically when this is set.
CRON_SECRET="another-long-random-string"

# Shown in "Good morning, …" on the Today page (optional).
DISPLAY_NAME=""

# Local only: run the daily refresh in-process with node-cron ("1" to enable).
ENABLE_CRON="0"
CRON_SCHEDULE="0 8 * * *"
TZ="America/Toronto"

# Sent as the User-Agent header on every fetch, so site owners can identify the traffic.
FETCH_USER_AGENT="TappedIn/1.0 (personal job tracker)"

# Resume and cover letter tailoring: local only (MiKTeX pdflatex, the `claude` CLI). Leave unset on Vercel.
# AUTO_APPLY_ENABLED=1
# Optional: model for the headless claude runs (defaults to your Claude Code default)
# AUTO_APPLY_MODEL=sonnet
