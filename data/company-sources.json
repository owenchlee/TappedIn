    {
      "key": "simplify-internships",
      "name": "Simplify internships",
      "careerUrl": "https://github.com/SimplifyJobs/Summer2027-Internships",
      "adapter": "simplify",
      "enabled": true,
      "config": { "url": "https://raw.githubusercontent.com/SimplifyJobs/Summer{year}-Internships/dev/.github/scripts/listings.json" },
      "match": { "regions": ["canada", "remote", "us"] }
    },
    {
      "key": "vanshb03-internships",
      "name": "Summer/Fall/Winter internships (vanshb03)",
      "careerUrl": "https://github.com/vanshb03/Summer2027-Internships",
